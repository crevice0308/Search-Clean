{
  "manifest_version": 3,
  "name": "Search Clean Lite",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "description": "Google検索のAIによる概要をブラウザー上で非表示にします。スイッチ1つで切り替えられる軽量な拡張機能です。",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Search Clean Lite",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search",
        "https://www.google.com/search?*",
        "https://google.com/search",
        "https://google.com/search?*",
        "https://www.google.co.jp/search",
        "https://www.google.co.jp/search?*",
        "https://google.co.jp/search",
        "https://google.co.jp/search?*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "optional_permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "updater.js"
  }
}
